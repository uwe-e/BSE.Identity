@inject IStringLocalizer<LoginDisplay> Localize


<AuthorizeView>
    <Authorized>
        <div slot="end">
            <FluentButton id="btnOpen1" Appearance="Appearance.Stealth" slot="end" @onclick="@(() => open = !open)">
                @context.User.Identity?.Name
                <FluentIcon Slot="end" Value="@GetChevronIcon()" Color="Microsoft.FluentUI.AspNetCore.Components.Color.Neutral" />
            </FluentButton>

            <FluentMenu Anchor="btnOpen1" @bind-Open="open">

                <FluentMenuItem>
                    <div slot="end">
                        <form method="post" id="frmLogout" action="Identity/Account/Logout">
                            <FluentButton Type="ButtonType.Submit" Appearance="Appearance.Accent">@Localize["Btn_Submit"]</FluentButton>
                        </form>
                    </div>
                </FluentMenuItem>

            </FluentMenu>
        </div>
    </Authorized>
</AuthorizeView>

@code {
    bool open = false;

    private Icon GetChevronIcon()
    {
        return open ? Icon.FromType<Icons.Regular.Size20.ChevronUp>() : Icon.FromType<Icons.Regular.Size20.ChevronDown>();
    }
}